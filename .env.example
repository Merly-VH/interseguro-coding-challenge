# Copiar a .env y completar con valores propios (nunca commitear .env real).
# Ambas APIs deben usar el mismo JWT_SECRET: go-qr-api firma los tokens,
# node-stats-api los valida.

# Secreto compartido para firmar/validar los JWT (HS256). Usar un valor largo
# y aleatorio, por ejemplo: openssl rand -base64 32
JWT_SECRET=

# API key requerida por go-qr-api para emitir un token en POST /api/token
# (header "X-Api-Key"). Cualquier valor propio, no predecible.
API_KEY=
